// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		}
	},

	// No "mounts" entry on purpose. A bind mount needs an absolute host path, and any
	// path hard-coded here exists on exactly one machine - everywhere else container
	// creation fails outright. To mount your own raw-file folder, add:
	//
	//   "mounts": [
	//       "type=bind,source=/absolute/path/to/MS1_RAWS,target=/workspaces/unbeQuant/files/raws_mounted"
	//   ],
	//
	// then keep that edit out of commits with:
	//
	//   git update-index --skip-worktree .devcontainer/devcontainer.json
	//
	// Run that in EVERY clone you add a mount to. It is a local index flag, it is not
	// pushed, and a clone without it will silently re-commit the entry. Undo with
	// --no-skip-worktree before intentionally editing this file.

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bash setup_docker.sh && bash compile_and_setup_depencies.sh",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
